<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
            <directory>tests/Discovery</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Integration tests use a dedicated, disposable database. Never point this at production. -->
        <env name="BL_TEST_DB_HOST" value="127.0.0.1"/>
        <env name="BL_TEST_DB_NAME" value="barberlead_test"/>
        <env name="BL_TEST_DB_USER" value="bl"/>
        <env name="BL_TEST_DB_PASS" value="bl"/>
    </php>
</phpunit>
